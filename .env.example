# Embrace Web RUM Demo — Environment Configuration
# Copy this file to .env and fill in your values.

# =============================================================================
# REQUIRED
# =============================================================================

# Your Embrace Web app ID — get it from https://dash.embrace.io
EMBRACE_APP_ID=

# =============================================================================
# TRAFFIC GENERATOR (optional, only used with --profile traffic)
# =============================================================================

# Number of concurrent headless Chromium workers
TRAFFIC_WORKER_COUNT=5

# Milliseconds to wait between sessions per worker
TRAFFIC_SESSION_GAP_MS=2000

# Log level: trace, debug, info, warn, error, fatal
TRAFFIC_LOG_LEVEL=info

# Fraction of sessions that get a chaos event (0.0 - 1.0)
TRAFFIC_CHAOS_RATE=0.05

# =============================================================================
# CI / BOUNDED RUN (optional)
# =============================================================================

# Total sessions across all workers before exiting. 0 = unlimited.
TRAFFIC_MAX_SESSIONS=0

# Maximum wall-clock seconds before exiting. 0 = unlimited.
TRAFFIC_MAX_DURATION_S=0

# Identifies the CI workflow or environment (e.g., scheduled-light, chaos, local)
RUN_SOURCE=local

# Force a specific device profile by name (e.g., iphone-14, desktop-1080p)
TRAFFIC_DEVICE_OVERRIDE=

# Force a specific persona by name (e.g., buyer, bouncer)
TRAFFIC_PERSONA_OVERRIDE=

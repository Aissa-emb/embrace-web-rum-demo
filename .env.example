# Embrace Web RUM Demo — Environment Configuration
# Copy this file to .env and fill in your values.

# =============================================================================
# REQUIRED
# =============================================================================

# Your Embrace Web app ID — get it from https://dash.embrace.io
EMBRACE_APP_ID=

# =============================================================================
# TRAFFIC GENERATOR (optional, only used with --profile traffic)
# =============================================================================

# Number of concurrent headless Chromium workers
TRAFFIC_WORKER_COUNT=5

# Milliseconds to wait between sessions per worker
TRAFFIC_SESSION_GAP_MS=2000

# Log level: trace, debug, info, warn, error, fatal
TRAFFIC_LOG_LEVEL=info

# Fraction of sessions that get a chaos event (0.0 - 1.0)
TRAFFIC_CHAOS_RATE=0.05
